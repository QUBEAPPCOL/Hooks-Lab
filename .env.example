# Base de datos (Postgres / Supabase)
DATABASE_URL=postgres://postgres@localhost:5432/hookslab

# Acceso a la app (MVP de uso interno)
APP_PASSWORD=cambia-esto
AUTH_SECRET=genera-un-valor-largo-aleatorio

# Proveedores de IA (solo servidor, nunca en el cliente)
LLM_PRIMARY=anthropic          # anthropic | openai
LLM_FALLBACK=openai            # opcional; vacío = sin respaldo
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
